# Obsidian 个人 UI 状态与缓存不入库
/.obsidian/*
!/.obsidian/app.json

# 系统杂项
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc

# 论文整页渲染中间图；仓库只保留裁剪后的 Fig. 1 和重绘态图
/attachments/sun2022-[1-4].png
/attachments/sun2022_fig1-3.png
/attachments/sun2022_fig1_zoom.png

# 网盘同步程序的标记文件（属于本机同步配置，不入库）
.stfolder*
.stignore

# 本地仿真输出（体积大、机器相关），保留绘图脚本
/runs/*
!/runs/plot_page2001.py
