!TEXT
    =========================================================================================================================
    "Quantum-Cascade Lasers"
    https://www.nextnano.com/docu/nextnanoplus/tutorials/1D_quantum_cascade_laser.html
    -------------------------------------------------------------------------------------------------------------------------
    This input file is provided to you by nextnano GmbH (https://www.nextnano.com) 
    The last revision of this input file was done on 2025-07-15
    Compatible with nextnano++ 2.2.3
    =========================================================================================================================
    References:
    -------------------------------------------------------------------------------------------------------------------------
    Quantum-cascade lasers without injector regions operating above room temperature
    A. Friedrich, G. B�hm, M.C. Amann, and G. Scarpa
    Appl. Phys. Lett. 86, 161114 (2005)
    https://doi.org/10.1063/1.1906302
    =========================================================================================================================
!ENDTEXT

$temperature = 300.0      # [K]
$electric_field = 110e5   # [V/m]

run{ 
    strain{ }  
    quantum{ }
}

global{ 
    simulate1D{ }
    crystal_zb{ 
        x_hkl = [1, 0, 0]
        y_hkl = [0, 1, 0]
    }
    substrate{ name = "InP" }
    temperature = $temperature 
}

impurities{ 
    donor{ 
        name = "impurity1"
        energy = 0.0058  # energy relative to 'nearest' band edge (n-type -> conduction band, p-type -> valence band)
        degeneracy = 2   # degeneracy of energy levels, 2 for n-type, 4 for p-type
    }
}

contacts{ 
    fermi{ name = "fermi_zero" bias = 0 }
}

structure{ 
    output_material_index{ }
    output_region_index{ }
    region{  # InGaAs well (default)
        everywhere{ } 
        contact { name = fermi_zero }
        ternary_constant{ 
            name = "In(x)Ga(1-x)As"
            alloy_x = 0.6
        }
    }
    region{  # AlInAs barrier  3.4 nm (n-type doped)
        line{ x = [0, 3.4] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.3 nm
        line{ x = [7.4, 8.7] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  0.9 nm
        line{ x = [13.9, 14.8] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.9 nm
        line{ x = [17.4, 19.3] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  3.4 nm (n-type doped)
        line{ x = [22.5, 25.9] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.3 nm
        line{ x = [29.9, 31.2] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  0.9 nm
        line{ x = [36.4, 37.3] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.9 nm
        line{ x = [39.9, 41.8] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  3.4 nm (n-type doped)
        line{ x = [45.0, 48.4] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.3 nm
        line{ x = [52.4, 53.7] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  0.9 nm
        line{ x = [58.9, 59.8] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.9 nm
        line{ x = [62.4, 64.3] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  3.4 nm (n-type doped)
        line{ x = [67.5, 70.9] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.3 nm
        line{ x = [74.9, 76.2] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  0.9 nm
        line{ x = [81.4, 82.3] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # AlInAs barrier  1.9 nm
        line{ x = [84.9, 86.8] }
        ternary_constant{ 
            name = "Al(x)In(1-x)As"
            alloy_x = 0.56
        }
    }
    region{  # doping  3.4 / 4.0 nm
        line{ x = [0, 7.4] }
        doping{ 
            constant{ 
                name = "impurity1" 
                conc = 1.0E17 
            }
        }
    }
    region{  # doping  3.2 / 3.4 / 4.0 nm
        line{ x = [19.3, 29.9] }
        doping{ 
            constant{ 
                name = "impurity1" 
                conc = 1.0E17 
            }
        }
    }
    region{  # doping  3.2 / 3.4 / 4.0 nm
        line{ x = [41.8, 52.4] }
        doping{ 
            constant{ 
                name = "impurity1" 
                conc = 1.0E17 
            }
        }
    }
    region{  # doping  3.2 / 3.4 / 4.0 nm
        line{ x = [64.3, 74.9] }
        doping{ 
            constant{ 
                name = "impurity1" 
                conc = 1.0E17 
            }
        }
    }
    region{  # doping  3.2 nm
        line{ x = [86.8, 90.0] }
        doping{ 
            constant{ 
                name = "impurity1" 
                conc = 1.0E17 
            }
        }
    }
    output_alloy_composition{ }
    output_impurities{ }
    output_contact_index{ }
}

grid{ 
    xgrid{ 
        line{  pos = 0.0    spacing = 0.2 }
        line{  pos = 3.4    spacing = 0.2 } 
        line{  pos = 7.4    spacing = 0.2 } 
        line{  pos = 8.7    spacing = 0.2 } 
        line{  pos = 13.9   spacing = 0.2 } 
        line{  pos = 14.8   spacing = 0.2 } 
        line{  pos = 17.4   spacing = 0.2 } 
        line{  pos = 19.3   spacing = 0.2 } 
        line{  pos = 22.5   spacing = 0.2 } 
        line{  pos = 25.9   spacing = 0.2 } 
        line{  pos = 29.9   spacing = 0.2 } 
        line{  pos = 31.2   spacing = 0.2 } 
        line{  pos = 36.4   spacing = 0.2 } 
        line{  pos = 37.3   spacing = 0.2 } 
        line{  pos = 39.9   spacing = 0.2 } 
        line{  pos = 41.8   spacing = 0.2 } 
        line{  pos = 45.0   spacing = 0.2 } 
        line{  pos = 48.4   spacing = 0.2 } 
        line{  pos = 52.4   spacing = 0.2 } 
        line{  pos = 53.7   spacing = 0.2 } 
        line{  pos = 58.9   spacing = 0.2 } 
        line{  pos = 59.8   spacing = 0.2 } 
        line{  pos = 62.4   spacing = 0.2 } 
        line{  pos = 64.3   spacing = 0.2 } 
        line{  pos = 67.5   spacing = 0.2 } 
        line{  pos = 70.9   spacing = 0.2 } 
        line{  pos = 74.9   spacing = 0.2 } 
        line{  pos = 76.2   spacing = 0.2 } 
        line{  pos = 81.4   spacing = 0.2 } 
        line{  pos = 82.3   spacing = 0.2 } 
        line{  pos = 84.9   spacing = 0.2 } 
        line{  pos = 86.8   spacing = 0.2 } 
        line{  pos = 90.0   spacing = 0.2 }
    }
}

classical{    
    Gamma{ } 
    L{ }
    X{ }
    HH{ }
    LH{ }
    SO{ }
    
    bulk_dispersion{ 
        KP8{ }                      # calculate bulk k.p dispersion of the material
        path{                       # calculate bulk k.p dispersion along custom path in k-space. 
            name = "bulk_100_to_000_110"                    
            position{ x = 11 }      # point, where the dispersion has to be calculated.
            point{ k = [1.0, 0.0, 0.0] } 
            point{ k = [0.0, 0.0, 0.0] }
            point{ k = [0.7071, 0.7071, 0.0] }
            spacing  = 0.01         # Approximate spacing for intermediate points in the path segments [nm-1].
            shift_holes_to_zero = yes
        } 
        output_bulk_dispersions{ }  # output of all defined bulk k.p dispersions.
        output_masses{ }            # output of effective masses calculated from the dispersions. 
    }
    
    output_bandedges{ 
        averaged = no 
        profiles = "Gamma X Delta L HH LH SO" 
    }
    output_bandgap{ }
    output_carrier_densities{ }
    output_intrinsic_density{ }
}

strain{ 
    pseudomorphic_strain{ }
    output_strain_tensor{ }
    output_hydrostatic_strain{ }
}

poisson{ 
    electric_field{ 
        strength             = $electric_field 
        reference_potential  = 2.737865  # potential offset; to be consistent with nn3
    }
    output_potential{ }
}

quantum { 
    region{ 
        name = "quantum_region"
        x = [0, 90] 
        no_density = yes
        boundary{ x = dirichlet }
        
        kp_8band{ 
            num_electrons = 100
            avoid_spurious = yes 
        }
        
        transition_energies{ KP8{ } }
        
        output_wavefunctions{ 
            max_num = 200
            all_k_points = yes
            amplitudes = no
            probabilities = yes
            scale = 0.5
        }
        
        momentum_matrix_elements{ 
            polarization{ name = "component_x" re = [1, 0, 0] }
            KP8{ }
        } 
        dipole_moment_matrix_elements{
            polarization{ name = "component_x" re = [1, 0, 0] }
            KP8{ }
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}

database{ 
    ternary_zb { 
        valence = III_V 
        name =   "In(x)Ga(1-x)As" 
        binary_x =  "InAs" 
        binary_1_x =  "GaAs" 
        valence_bands{  
            bandoffset = -0.05057 
        }
    } 
}

