!TEXT
    Sun et al., Opt. Express 30 (2022), DOI 10.1364/OE.469573.
    Nine-micron MOCVD DAU/MS QCL, 50 stages.
    Well In0.593Ga0.407As; barrier Al0.638In0.362As.
    One period = 44.2800 nm; field = 48.0 kV/cm.
    B = barrier, W = well in the accompanying CSV.
!ENDTEXT

$electric_field = -4800000
$period = 44.2800
$num_periods = 3
$num_electrons = 100

run{
    strain{ }
    quantum{ }
}

output{ material_parameters{ } }

global{
    simulate1D{ }
    crystal_zb{
        x_hkl = [1, 0, 0]
        y_hkl = [0, 1, 0]
    }
    substrate{ name = "InP" }
    temperature = 300.0
}

contacts{
    fermi{
        name = "fermi_zero"
        bias = 0.0
    }
}

structure{
    output_material_index{ }
    output_region_index{ }
    region{
        everywhere{ }
        ternary_constant{
            name = "In(x)Ga(1-x)As"
            alloy_x = 0.593
        }
        contact{ name = "fermi_zero" }
    }

    region{  # barrier layer 1
        line{ x = [0.0000, 2.8000] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 3
        line{ x = [5.7000, 6.9500] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 5
        line{ x = [13.1200, 14.1200] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 7
        line{ x = [19.3700, 20.2500] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 9
        line{ x = [25.0000, 26.0900] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 11
        line{ x = [30.1500, 31.3700] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 13
        line{ x = [34.9300, 36.3500] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }
    region{  # barrier layer 15
        line{ x = [39.4000, 41.0800] }
        ternary_constant{ name = "Al(x)In(1-x)As" alloy_x = 0.638 }
        array_x{ max = 3 shift = 44.2800 }
    }

    output_alloy_composition{ }
}

grid{
    xgrid{
        line{ pos = 0.0000 spacing = 0.2 }
        line{ pos = 2.8000 spacing = 0.2 }
        line{ pos = 5.7000 spacing = 0.2 }
        line{ pos = 6.9500 spacing = 0.2 }
        line{ pos = 13.1200 spacing = 0.2 }
        line{ pos = 14.1200 spacing = 0.2 }
        line{ pos = 19.3700 spacing = 0.2 }
        line{ pos = 20.2500 spacing = 0.2 }
        line{ pos = 25.0000 spacing = 0.2 }
        line{ pos = 26.0900 spacing = 0.2 }
        line{ pos = 30.1500 spacing = 0.2 }
        line{ pos = 31.3700 spacing = 0.2 }
        line{ pos = 34.9300 spacing = 0.2 }
        line{ pos = 36.3500 spacing = 0.2 }
        line{ pos = 39.4000 spacing = 0.2 }
        line{ pos = 41.0800 spacing = 0.2 }
        line{ pos = 44.2800 spacing = 0.2 }
        line{ pos = 88.5600 spacing = 0.2 }
        line{ pos = 132.8400 spacing = 0.2 }
    }
}

classical{
    Gamma{ }
    L{ }
    X{ }
    HH{ }
    LH{ }
    SO{ }
    output_bandedges{ averaged = no }
    output_bandgap{ }
}

strain{
    pseudomorphic_strain{ }
    output_strain_tensor{ }
    output_hydrostatic_strain{ }
}

poisson{
    electric_field{
        strength = $electric_field
        reference_potential = 0.0
    }
    output_potential{ }
    output_electric_field{ }
}

quantum{
    region{
        name = "quantum_region"
        x = [0.0, 132.8400]
        no_density = yes
        boundary{ x = dirichlet }
        kp_8band{
            num_electrons = $num_electrons
            avoid_spurious = yes
        }
        transition_energies{ KP8{ } }
        output_wavefunctions{
            max_num = 240
            all_k_points = yes
            amplitudes = no
            probabilities = yes
        }
        momentum_matrix_elements{
            polarization{ name = "component_x" re = [1, 0, 0] }
            KP8{ }
        }
        dipole_moment_matrix_elements{
            polarization{ name = "component_x" re = [1, 0, 0] }
            KP8{ }
            output_matrix_elements = yes
            output_oscillator_strengths = yes
        }
    }
}
